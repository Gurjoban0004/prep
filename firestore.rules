rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user can only read and write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Global stats (student count) — any authenticated user can read,
    // only the server-side increment from signed-in users allowed to write
    match /stats/global {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.resource.data.keys().hasOnly(['studentCount', 'lastJoined'])
                   && request.resource.data.studentCount is number;
    }
  }
}
